{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @workspace/salam-bumi dev",
    "dev:pages": "wrangler pages dev artifacts/salam-bumi/dist/public --d1=DB --r2=BUCKET --port 8788 --live-reload --remote",
    "dev:pages:local": "wrangler pages dev artifacts/salam-bumi/dist/public --d1=DB --r2=BUCKET --port 8788 --live-reload",
    "dev:full": "concurrently \"pnpm dev\" \"pnpm dev:pages\"",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "build:frontend": "pnpm --filter @workspace/salam-bumi build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
